<section class="page $page_class" id="page-$number">
  <div class="page-head">
    <div class="page-head-top">
      <span class="page-chip"><span class="chip-icon" aria-hidden="true"></span><span class="chip-label"></span></span>
      <span class="page-number">$number_label</span>
    </div>
    <h1 class="page-title t-edit">$title</h1>
    <p class="page-instructions$instructions_edit_class">$instructions</p>
  </div>
  <div class="page-body">
$body
  </div>
</section>
