    <div class="crossword-grid" style="grid-template-columns: repeat($columns, 1fr); width: min(100%, ${width}mm);">
$cells
    </div>
    <div class="clue-lists">
      <div class="clue-column">
        <h2>$across_label</h2>
        <ol class="clues">
$across
        </ol>
      </div>
      <div class="clue-column">
        <h2>$down_label</h2>
        <ol class="clues">
$down
        </ol>
      </div>
    </div>
