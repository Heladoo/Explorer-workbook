<!DOCTYPE html>
<html lang="$language" dir="$direction" data-page-format="$page_format" data-page-count="$page_count">
<head>
<meta charset="utf-8">
<title>$title</title>
<style>
$fonts
$css
</style>
</head>
<body class="$body_class">
$contents
$pages
<script>
(function () {
  "use strict";

  var STR = $editor_strings;

  var fileInput = document.createElement("input");
  fileInput.type = "file";
  fileInput.accept = "image/*";
  fileInput.style.display = "none";
  document.body.appendChild(fileInput);

  var activeSlot = null;
  var activeTextEl = null;
  var dirty = false;
  var fileHandle = null;

  function findSlot(target) {
    // .art-blank (the drawing page's empty frame) is a space for the child
    // to draw in by hand, never a photo/illustration slot — see art_blank
    // .html.tmpl and the matching exclusion in book.css.
    var slot = target.closest(".art, .spotting-art");
    return slot && slot.classList.contains("art-blank") ? null : slot;
  }

  document.addEventListener("click", function (event) {
    // A photo slot (.art) can contain editable text boxes (.art-label,
    // .art-note) — let those handle their own click first, or every click
    // placing a text cursor would also pop the file picker.
    if (event.target.closest(".t-edit, .t-edit-btn")) return;
    var slot = findSlot(event.target);
    if (!slot) return;
    event.preventDefault();
    activeSlot = slot;
    fileInput.value = "";
    fileInput.click();
  });

  fileInput.addEventListener("change", function () {
    var file = fileInput.files && fileInput.files[0];
    if (!file || !activeSlot) return;
    var slot = activeSlot;
    var reader = new FileReader();
    reader.onload = function () {
      var labelNode = slot.querySelector(".art-label, .spotting-label");
      // .art-label carries its own pencil button as a child by now; read the
      // wrapped .t-edit-text span so the button's glyph doesn't leak into alt.
      var altSource = labelNode && (labelNode.querySelector(":scope > .t-edit-text") || labelNode);
      var alt = altSource ? altSource.textContent.trim() : "Illustration";
      slot.innerHTML = "";
      slot.classList.add("filled");
      var img = document.createElement("img");
      img.src = String(reader.result);
      img.alt = alt;
      slot.appendChild(img);
      markDirty();
    };
    reader.readAsDataURL(file);
  });

  var saveBar = document.createElement("div");
  saveBar.className = "editor-savebar";
  var saveText = document.createElement("span");
  saveText.className = "save-status";
  saveText.textContent = STR.unsavedChanges;
  var saveButton = document.createElement("button");
  saveButton.type = "button";
  saveButton.className = "editor-save-btn";
  saveButton.textContent = STR.saveWorkbook;
  var pdfButton = document.createElement("button");
  pdfButton.type = "button";
  pdfButton.className = "editor-pdf-btn";
  pdfButton.textContent = STR.saveAsPdf;
  saveBar.appendChild(saveText);
  saveBar.appendChild(saveButton);
  saveBar.appendChild(pdfButton);
  document.body.appendChild(saveBar);
  saveButton.addEventListener("click", save);
  pdfButton.addEventListener("click", printPdf);

  // Printing through the browser's own dialog only ever offers loose page
  // sizes (A4, Letter, ...) — there is no way to ask it for this book's real
  // format (A5, two-up on an A4 sheet, folded and stapled), so a "Save as
  // PDF" through window.print() came out A4 regardless of what the book
  // actually is. /print runs the exact same headless-Chromium + imposition
  // pipeline the generator itself uses — reading the format straight off
  // this document (its own data-page-format/data-page-count if present,
  // otherwise sniffed from its @page CSS and .page sections — see
  // src/rendering/print_metadata.py — so even a book saved before this
  // endpoint existed still prints correctly) — so the result matches the
  // book's real format instead of whatever the browser defaults to.
  // Set only when this document was opened through the local server
  // (/files/<slug>/...) rather than off local disk — that slug is what lets
  // /print write the edited book back into its own output folder and hand
  // the browser off to the saved page afterwards. See _resolve_book_slug in
  // src/web.py.
  var bookSlug = (function () {
    var match = /^\/files\/([^/]+)\//.exec(window.location.pathname || "");
    return match ? match[1] : null;
  })();

  async function printPdf() {
    stopEditing(activeTextEl);
    var originalLabel = pdfButton.textContent;
    pdfButton.disabled = true;
    pdfButton.textContent = STR.preparingPdf;
    try {
      var response;
      try {
        var printUrl = "/print" + (bookSlug ? "?slug=" + encodeURIComponent(bookSlug) : "");
        response = await fetch(printUrl, {
          method: "POST",
          headers: { "Content-Type": "text/html; charset=utf-8" },
          body: serializedDocument(),
        });
      } catch (networkErr) {
        // No server to ask at all — e.g. this file was opened directly from
        // disk rather than through `python -m src.web`. That is the expected
        // offline case, not an error, so degrade quietly to what printing
        // already did before this endpoint existed.
        window.print();
        return;
      }
      if (!response.ok) {
        // A server *is* there but genuinely couldn't print this document —
        // worth saying so, rather than silently reproducing the old
        // A4-no-matter-what behaviour with no explanation.
        var message = (await response.text().catch(function () { return ""; }))
          || ("HTTP " + response.status);
        window.alert(STR.printFallbackAlert.replace("{message}", message));
        window.print();
        return;
      }
      var blob = await response.blob();
      var disposition = response.headers.get("Content-Disposition") || "";
      var encoded = /filename\*=UTF-8''([^;]+)/i.exec(disposition);
      var plain = /filename="([^"]+)"/.exec(disposition);
      var filename = encoded ? decodeURIComponent(encoded[1]) : (plain ? plain[1] : "workbook.pdf");
      var url = URL.createObjectURL(blob);
      var link = document.createElement("a");
      link.href = url;
      link.download = filename;
      document.body.appendChild(link);
      link.click();
      link.remove();
      URL.revokeObjectURL(url);
      markClean();
      // A 200 here only means *a* PDF came back — this book's format may
      // still have failed to fold into a booklet (an odd page count, or the
      // imposition step itself hit something). Say so rather than handing
      // over plain A5 pages under no-visible-difference circumstances.
      var warning = response.headers.get("X-Print-Warning");
      if (warning) {
        window.alert(STR.bookletWarningAlert.replace("{warning}", decodeURIComponent(warning)));
      }
      // The server only sends this back when it could tell which book this
      // is and wrote the edits into its output folder (see
      // _resolve_book_slug in src/web.py) — that's the signal this is a
      // real save, not just a one-off PDF, so hand the tab off to the
      // saved-book page instead of leaving the editor open behind a download.
      var savedSlug = response.headers.get("X-Saved-Slug");
      if (savedSlug) {
        window.location.href = "/saved/" + encodeURIComponent(decodeURIComponent(savedSlug));
        return;
      }
    } finally {
      pdfButton.disabled = false;
      pdfButton.textContent = originalLabel;
    }
  }

  function markDirty() {
    dirty = true;
    saveBar.classList.add("dirty");
  }

  function markClean() {
    dirty = false;
    saveBar.classList.remove("dirty");
  }

  function suggestedName() {
    var path = window.location.pathname || "";
    var base = decodeURIComponent(path.substring(path.lastIndexOf("/") + 1));
    return base && /\.html?$$/i.test(base) ? base : "workbook.html";
  }

  function serializedDocument() {
    // Save a clone, not the live document: strip the pencil buttons and any
    // in-progress editing state first so the file on disk is clean markup,
    // not a snapshot of the editor's own scaffolding.
    var clone = document.documentElement.cloneNode(true);
    Array.prototype.forEach.call(clone.querySelectorAll(".t-edit-btn"), function (btn) {
      btn.remove();
    });
    Array.prototype.forEach.call(clone.querySelectorAll(".t-edit"), function (el) {
      el.classList.remove("editing");
    });
    Array.prototype.forEach.call(clone.querySelectorAll(".t-edit-text"), function (el) {
      el.removeAttribute("contenteditable");
    });
    var bar = clone.querySelector(".editor-savebar");
    if (bar) bar.remove();
    return "<!DOCTYPE html>\n" + clone.outerHTML;
  }

  async function save() {
    var blob = new Blob([serializedDocument()], { type: "text/html" });

    if (window.showSaveFilePicker) {
      try {
        if (!fileHandle) {
          fileHandle = await window.showSaveFilePicker({
            suggestedName: suggestedName(),
            types: [{ description: "HTML", accept: { "text/html": [".html"] } }],
          });
        }
        var writable = await fileHandle.createWritable();
        await writable.write(blob);
        await writable.close();
        markClean();
        return;
      } catch (err) {
        if (err && err.name === "AbortError") return;
        fileHandle = null;
        // Fall through to the download fallback below.
      }
    }

    var url = URL.createObjectURL(blob);
    var link = document.createElement("a");
    link.href = url;
    link.download = suggestedName();
    document.body.appendChild(link);
    link.click();
    link.remove();
    URL.revokeObjectURL(url);
    markClean();
  }

  Array.prototype.forEach.call(document.querySelectorAll(".art, .spotting-art"), function (slot) {
    if (slot.classList.contains("art-blank")) return;
    slot.title = slot.classList.contains("filled") ? STR.replacePhoto : STR.addPhoto;
  });

  // -- in-browser text editing ---------------------------------------------
  // Every reader-facing text box was rendered with a .t-edit class. Wrap its
  // text in an inner .t-edit-text span (so the pencil button, appended as a
  // sibling, never itself becomes part of the editable content or the saved
  // text) and give it a pencil button that turns editing on for that one box.

  function stopEditing(el) {
    if (!el) return;
    var text = el.querySelector(":scope > .t-edit-text");
    if (text) text.removeAttribute("contenteditable");
    el.classList.remove("editing");
    if (activeTextEl === el) activeTextEl = null;
  }

  function startEditing(el) {
    if (activeTextEl && activeTextEl !== el) stopEditing(activeTextEl);
    var text = el.querySelector(":scope > .t-edit-text");
    if (!text) return;
    text.dataset.orig = text.textContent;
    text.setAttribute("contenteditable", "true");
    el.classList.add("editing");
    activeTextEl = el;
    text.focus();
    var range = document.createRange();
    range.selectNodeContents(text);
    var selection = window.getSelection();
    selection.removeAllRanges();
    selection.addRange(range);
  }

  Array.prototype.forEach.call(document.querySelectorAll(".t-edit"), function (box) {
    var text = box.querySelector(":scope > .t-edit-text");
    if (!text) {
      text = document.createElement("span");
      text.className = "t-edit-text";
      while (box.firstChild) text.appendChild(box.firstChild);
      box.appendChild(text);
    }

    var btn = document.createElement("button");
    btn.type = "button";
    btn.className = "t-edit-btn";
    btn.textContent = "✎";
    btn.title = STR.editText;
    btn.addEventListener("click", function (event) {
      event.preventDefault();
      event.stopPropagation();
      startEditing(box);
    });
    box.appendChild(btn);

    text.addEventListener("input", markDirty);

    text.addEventListener("keydown", function (event) {
      if (event.key === "Enter") {
        event.preventDefault();
        text.blur();
      } else if (event.key === "Escape") {
        event.preventDefault();
        text.textContent = text.dataset.orig || "";
        text.blur();
      }
    });

    text.addEventListener("blur", function () {
      stopEditing(box);
    });
  });
})();
</script>
</body>
</html>
