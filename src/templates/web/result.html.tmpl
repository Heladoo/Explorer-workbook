<!DOCTYPE html>
<html lang="$language" dir="$direction">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>$title</title>
<style>
$css
</style>
</head>
<body>
<main class="lean">
$step_indicator

  <header class="masthead">
    <img class="logo" src="/static/logo-color.png" alt="Adventure Kit" width="275" height="220">
    <p class="eyebrow">$eyebrow</p>
    <h1 dir="auto">$title</h1>
    <p>$subtitle</p>
  </header>

$message

  <div class="card">
    <div class="downloads">
$downloads
    </div>

    <h2>$checklist_heading</h2>
    <p class="hint">$checklist_body</p>
    <p class="hint">$recommendation</p>
$reference_note

    <h2>$prompts_heading</h2>
    <p class="hint">$prompts_hint</p>
    <div class="prompt-list">
$prompt_items
    </div>

    <div class="actions">
      <a class="button" href="/" target="_blank" rel="noopener">$make_another</a>
    </div>
  </div>
</main>
<script>
(function () {
  document.addEventListener('click', function (event) {
    var button = event.target.closest('.copy-btn');
    if (!button) return;
    var box = button.closest('.prompt-box');
    var textarea = box && box.querySelector('textarea');
    if (!textarea) return;
    var original = button.textContent;
    var done = button.getAttribute('data-copied-label') || original;
    var restore = function () { button.textContent = original; };
    var mark = function () { button.textContent = done; setTimeout(restore, 1500); };
    var legacyCopy = function () {
      textarea.select();
      try { document.execCommand('copy'); } catch (err) { /* ignore */ }
      mark();
    };
    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(textarea.value).then(mark, legacyCopy);
    } else {
      legacyCopy();
    }
  });
})();
</script>
</body>
</html>
