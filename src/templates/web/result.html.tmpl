<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>$title</title>
<style>
$css
</style>
</head>
<body>
<main class="lean">
  <header class="masthead">
    <p class="eyebrow">All done</p>
    <h1 dir="auto">$title</h1>
    <p>$page_count pages, ready to print.</p>
  </header>

$message

  <div class="card">
    <div class="downloads">
$downloads
    </div>

    <h2>What's in it</h2>
    <ol class="pages">
$pages
    </ol>

    <h2>About the drawings</h2>
    <p class="hint">$prompt_summary</p>
$reference_note
    <details>
      <summary>All $prompt_count prompts</summary>
      <ul class="prompt-list">
$prompt_files
      </ul>
    </details>

    <div class="actions">
      <a class="button" href="/">Make another one</a>
    </div>

    <div class="feedback" id="feedback" data-visitor="$visitor" data-book="$book_id">
      <h2>Quick one — how'd that go?</h2>
      <div class="feedback-options">
        <button type="button" data-rating="great">🙌 Loved it</button>
        <button type="button" data-rating="fine">🙂 It's fine</button>
        <button type="button" data-rating="poor">😕 Not really</button>
      </div>
      <textarea rows="2" placeholder="Anything you want to tell us? (optional)"></textarea>
      <button type="button" class="feedback-send">Send</button>
      <p class="feedback-thanks">Thanks — that helps.</p>
    </div>
  </div>
</main>
<script>
(function () {
  var box = document.getElementById('feedback');
  if (!box) return;
  var rating = null;
  var buttons = box.querySelectorAll('[data-rating]');
  var textarea = box.querySelector('textarea');
  var send = box.querySelector('.feedback-send');

  buttons.forEach(function (button) {
    button.addEventListener('click', function () {
      rating = button.getAttribute('data-rating');
      buttons.forEach(function (b) { b.style.opacity = (b === button) ? '1' : '.45'; });
      box.classList.add('expanded');
    });
  });

  send.addEventListener('click', function () {
    if (!rating) return;
    var body = new URLSearchParams({
      visitor: box.getAttribute('data-visitor'),
      book: box.getAttribute('data-book'),
      rating: rating,
      comment: textarea.value.slice(0, 2000)
    });
    fetch('/feedback', { method: 'POST', body: body }).catch(function () {});
    box.classList.add('sent');
  });
})();
</script>
</body>
</html>
