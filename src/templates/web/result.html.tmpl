<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>$title</title>
<style>
$css
</style>
</head>
<body>
<main class="lean">
  <header class="masthead">
    <p class="eyebrow">All done</p>
    <h1 dir="auto">$title</h1>
    <p>$page_count pages, ready to print.</p>
  </header>

$message

  <div class="card">
    <div class="downloads">
$downloads
    </div>

    <h2>What's in it</h2>
    <ol class="pages">
$pages
    </ol>

    <h2>About the drawings</h2>
    <p class="hint">$prompt_summary</p>
$reference_note
    <details>
      <summary>All $prompt_count prompts</summary>
      <ul class="prompt-list">
$prompt_files
      </ul>
    </details>

    <div class="actions">
      <a class="button" href="/">Make another one</a>
    </div>
  </div>
</main>
</body>
</html>
